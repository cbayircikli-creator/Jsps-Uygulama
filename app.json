{
  "expo": {
    "name": "Uzman Kolluk",
    "slug": "uzman-kolluk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uzmankolluk.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B6B47",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.uzmankolluk.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Uzman Kolluk",
      "themeColor": "#0B6B47",
      "backgroundColor": "#EEF5F1"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#053A27"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Uzman Kolluk, Pusula ve Konum ekranında koordinatını ve haritayı göstermek için konumuna erişir. Konumun hiçbir yere gönderilmez."
        }
      ]
    ],
    "scheme": "uzmankolluk"
  }
}
